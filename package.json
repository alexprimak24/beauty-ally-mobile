  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || >=24.3.0 <25"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint app components constants context design features hooks services types utils --cache --cache-location .cache/eslint --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --coverage --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci"
