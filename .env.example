# Values prefixed with EXPO_PUBLIC_ are embedded in the client bundle and must
# never contain server secrets or private credentials.

# Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Beauty Ally-compatible API
EXPO_PUBLIC_BACKEND_ENDPOINT=http://localhost:8080

# Store subscriptions (use the public platform SDK keys)
EXPO_PUBLIC_RC_IOS_KEY=appl_replace_me
EXPO_PUBLIC_RC_ANDROID_KEY=goog_replace_me

# Product analytics
EXPO_PUBLIC_POSTHOG_KEY=phc_replace_me

# Optional client error reporting
EXPO_PUBLIC_SENTRY_DSN=

# Optional build-only credential used to upload Sentry source maps.
# This is a secret: never rename it with an EXPO_PUBLIC_ prefix.
SENTRY_AUTH_TOKEN=
